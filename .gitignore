/target
**/*.rs.bk
*.pdb
.DS_Store
/dist
node_modules
.trunk/

# Agent worktrees and local session state
.claude/
# just up writes the local Looking Glass bind here (and a copy under
# ~/.rabbithole or $XDG_STATE_HOME/rabbithole, outside the repo).
.rabbithole/

# mdBook rendered output
docs/book/

# Playwright E2E web harness (e2e-web/) build + run artifacts
e2e-web/node_modules/
e2e-web/test-results/
e2e-web/playwright-report/

# Built SPA output from `trunk build` (serve via `burrow --web-root`)
crates/ui-web/dist/
.gstack/
# Impeccable's live-server scratch (its critique snapshots are kept)
.impeccable/live/

# A burrow's runtime data dir (the default --data-dir): its database, blobs,
# ctl socket and, above all, its identity keys. Never commit one.
/burrow-data/
